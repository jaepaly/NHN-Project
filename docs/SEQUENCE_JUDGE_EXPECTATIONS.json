{
  "schemaVersion": 1,
  "purpose": "Initial 30-case intent expectations for sequence Judge experiments. These are semantic and choreography constraints, not exact fixture JSON answers.",
  "modeSemantics": {
    "single_preferred": "A single spell is preferred, but a compact, well-grounded sequence may be acceptable.",
    "sequence_preferred": "A sequence is preferred, but an exceptional single spell may pass manual review if it preserves the full intent.",
    "sequence_required": "A single spell loses an explicit structural meaning and is considered a failure.",
    "either": "Single and sequence interpretations are comparably natural; judge by intent and visual quality."
  },
  "relationEnums": [
    "order",
    "parallel",
    "repetition",
    "delay",
    "causality",
    "transition",
    "accumulation",
    "persistence",
    "movement",
    "finale"
  ],
  "globalHardRules": {
    "maxSequences": 10,
    "maxBehaviorsPerSequence": 5,
    "behaviorTypes": [
      "form",
      "move",
      "wait"
    ],
    "waitMustBeAlone": true,
    "moveRequiresElement": true,
    "specPowerMustBeZero": true,
    "specCostMustBeZero": true,
    "forbidUnsupportedResourceEffects": true,
    "forbidDecorativeMove": true,
    "forbidInventedEnums": true
  },
